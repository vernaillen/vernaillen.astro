# Static-hosting rules for Apache (Combell). Files under public/ are copied to
# the site root by `astro build`, so this lands at the docroot.

# --- Long-cache immutable assets ---------------------------------------------
# /_astro/ is Astro's content-hashed build output (JS/CSS/fonts/optimized
# images); /images/ never changes in place. Safe to cache hard (1yr) at both
# the Bunny CDN edge and in the browser, instead of Bunny's 30-day default for
# headerless static files. Content that changes in place on deploy — including
# the generated OG images below — is handled separately.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_astro/" long_cache=1
  SetEnvIf Request_URI "^/images/" long_cache=1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=long_cache
</IfModule>

# --- Generated OG images: short-lived, not immutable -------------------------
# /og/<path>.png (src/pages/og/[...slug].png.ts) is a stable per-route URL
# whose PNG content can change (a title/description edit) without the URL
# changing, unlike the hashed /_astro/ assets above — so it's cached, but not
# `immutable`, and for a day rather than a year.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/og/" og_image=1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=86400" env=og_image
</IfModule>

# --- Deploy-scoped content: cache at the edge, revalidate in the browser -----
# HTML, the sitemap and the llms.txt files change in place on every deploy.
# Sending no header meant Bunny fell back to no-cache and MISSed every single
# HTML request, so each page view paid a full round trip to Ghent *plus* the
# extra CDN hop — measurably slower than not having a CDN at all (161ms vs
# 106ms TTFB). s-maxage lets the edge hold them while max-age=0 keeps browsers
# revalidating, which is safe because ci.yml purges the pull zone after every
# rsync. NOTE: the purge step is skipped when BUNNY_PULLZONE_ID is unset —
# leave that variable set, or a deploy can leave the edge stale.
# env=!long_cache so the immutable prefixes above always win.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, s-maxage=31536000" env=!long_cache
  </FilesMatch>
</IfModule>

# --- No trailing-slash redirect ----------------------------------------------
# `astro build` writes blog/index.html, never blog.html, so a request for
# /blog is a request for a directory and mod_dir answers it with a
# DirectorySlash 301 to /blog/. Apache builds that redirect from the Host it was
# given, and Bunny origin-pulls with Host: vernaillencom.webhosting.be — so the
# 301 pointed at the ORIGIN hostname and threw visitors off the CDN onto the raw
# Combell pack. Every <link rel="canonical"> and every sitemap.xml entry is
# slash-less, so the canonical URL of every page on the site did this; crawlers
# (unlighthouse included) dropped it as a cross-domain redirect.
#
# The rewrite below alone is NOT enough: mod_dir's fixup hook beats mod_rewrite's
# internal redirect, so the 301 still wins. Verified against Apache 2.4 locally —
# with this Off and the rewrite on, /blog answers 200 with blog/index.html.
#
# DirectorySlash needs AllowOverride Indexes, and a pack that disallows it would
# 500 the whole site. Verified permitted on this pack with a throwaway
# subdirectory (200, not 500). Apache warns Off can expose autoindex listings at
# slash-less URLs; not a risk here — this pack returns 403 for index-less
# directories, so autoindex is off.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

# --- Canonical host: vernaillen.com -> vernaillen.dev ------------------------
# The static site is deployed into the vernaillen.com pack; vernaillen.dev is the
# canonical hostname (site.url in src/lib/site.ts). When .com (or its www) resolves
# to this docroot, 301 it to the matching path on .dev. Query strings are carried
# over automatically. Dormant when .com is handled by a panel-level redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let ACME HTTP-01 through untouched: the pack cert is one multi-SAN cert that
  # includes vernaillen.com, so Combell's challenge responder must be able to
  # serve the .com token. Redirecting it here fails that SAN and the whole cert.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTP_HOST} ^(www\.)?vernaillen\.com$ [NC]
  RewriteRule ^ https://vernaillen.dev%{REQUEST_URI} [R=301,L]

  # --- Extensionless URLs: serve, don't redirect -----------------------------
  # Map /blog to blog/index.html internally. Needs DirectorySlash Off above to
  # have any effect — see that block. %{REQUEST_URI} rather than a backreference
  # because the operand here is the per-directory-stripped path, while the
  # substitution wants the full URL-path.
  # Must stay AFTER the .com rule above, which terminates with [R=301,L].
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]
</IfModule>

# --- Redirects ----------------------------------------------------------------
# Absolute on purpose: mod_alias expands a relative target against the request
# Host, and Bunny origin-pulls as vernaillencom.webhosting.be, so `Redirect 301
# /links /` sent visitors to the origin hostname instead of back to the site.
Redirect 301 /links https://vernaillen.dev/

# --- 404 ---------------------------------------------------------------------
ErrorDocument 404 /404.html
