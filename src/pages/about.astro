---
import { getEntry, render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import SectionLabel from '../components/SectionLabel.astro'
import { localImage } from '../lib/images'
import type { AboutPage } from '../content.config'

const page = await getEntry('pages', 'about')
const data = page!.data as AboutPage
const { Content } = await render(page!)

const images = await Promise.all(
  data.images.map(async (image) => ({ ...image, asset: await localImage(image.src) })),
)
const validImages = images.filter((image) => image.asset)
const photoColsClass = validImages.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'
---

<Base title={data.title} description={data.description} path="/about">
  <Masthead index="01" label="about" title={data.title} description={data.description} />

  {validImages.length > 0 && (
    <div class:list={['grid gap-px bg-(--color-border) border-b border-(--color-border)', photoColsClass]}>
      {validImages.map((image) => (
        <figure class="bg-(--color-bg)">
          <Image src={image.asset!} alt={image.alt} width={480} format="avif" loading="lazy" class:list={['aspect-square w-full', image.src.includes('logo') ? 'object-contain p-8' : 'object-cover']} />
          <figcaption class="p-3 border-t border-(--color-border) font-mono text-xs uppercase tracking-wider text-(--color-text-muted)">{image.alt}</figcaption>
        </figure>
      ))}
    </div>
  )}

  <section class="grid lg:grid-cols-12 border-b border-(--color-border)">
    <div class="lg:col-span-3 p-6 lg:p-8">
      <SectionLabel index="02" label="story" />
    </div>
    <div class="lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-8">
      <div class="blog-prose max-w-2xl">
        <Content />
      </div>
    </div>
  </section>
</Base>
