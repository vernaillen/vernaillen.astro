---
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import SectionLabel from '../components/SectionLabel.astro'
import { localImage } from '../lib/images'
import { getPage } from '../lib/content'

const page = await getPage('about')
const { data } = page
const { Content } = await render(page)

// The first entry of `images` is the portrait. The remaining entries fed the
// source site's polaroid strip (project logos) and are deliberately not shown.
const [portrait] = data.images
const portraitAsset = portrait && (await localImage(portrait.src))
---

<Base title={data.title} description={data.description} path="/about">
  <Masthead index="01" label="about" title={data.title} description={data.description} />

  <section class="grid lg:grid-cols-12 border-b border-(--color-border)">
    <div class="lg:col-span-4 p-6 lg:p-8">
      <SectionLabel index="02" label="story">
        {portraitAsset && (
          <figure class="mt-6 max-w-xs">
            <Image
              src={portraitAsset}
              alt={portrait.alt}
              width={400}
              height={400}
              format="avif"
              loading="eager"
              class="aspect-square w-full object-cover border border-(--color-border)"
            />
            <figcaption class="mt-3 label text-(--color-text-muted)">{portrait.alt}</figcaption>
          </figure>
        )}
      </SectionLabel>
    </div>
    <div class="lg:col-span-8 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-8">
      <div class="blog-prose max-w-2xl">
        <Content />
      </div>
    </div>
  </section>
</Base>
