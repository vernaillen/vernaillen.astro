---
import { getEntry, render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Reveal from '../components/Reveal.astro'
import { localImage } from '../lib/images'
import type { AboutPage } from '../content.config'

const page = await getEntry('pages', 'about')
const data = page!.data as AboutPage
const { Content } = await render(page!)

const portrait = await localImage(data.image.src)
---

<Base title={data.title} description={data.description} path="/about">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    {/* Mirrors the UPageHero + UColorModeAvatar layout of the Nuxt site. */}
    <div class="flex flex-col items-center gap-16 sm:flex-row sm:items-start">
      <div>
        <h1 class="fade-in text-3xl sm:text-5xl">{data.title}</h1>
        <p class="fade-in [--fade-delay:90ms] pt-4 font-mono text-(--color-text-muted)">{data.description}</p>
      </div>
      {portrait && (
        <Image
          src={portrait}
          alt={data.image.alt}
          width={400}
          height={400}
          format="avif"
          loading="eager"
          class="fade-in [--fade-delay:180ms] size-36 shrink-0 -mt-4 rounded-lg object-cover ring ring-(--color-border) ring-offset-3 ring-offset-(--color-bg) rotate-4"
        />
      )}
    </div>

    <Reveal class="blog-prose pt-12">
      <Content />
    </Reveal>
  </section>
</Base>
