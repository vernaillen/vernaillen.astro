---
import { getCollection, getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import Reveal from '../components/Reveal.astro'
import { localImage } from '../lib/images'
import { fftControlsHtml } from '../lib/fft-demo'
import type { LinksPage } from '../content.config'

const page = await getEntry('pages', 'projects')
const data = page!.data as LinksPage

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const fftPoster = await localImage('/images/fft-demo-poster.png')

// A video project ships `<name>.mp4` + `<name>.webm` in public/ and a
// `<name>-poster.png` raster next to the other project images.
const cardImages = await Promise.all(
  projects.map(async (project) =>
    localImage(project.data.video ? project.data.image.replace(/\.mp4$/, '-poster.png') : project.data.image),
  ),
)
---

<Base title={data.title} description={data.description} path="/projects">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="fade-in text-3xl sm:text-5xl">{data.title}</h1>
    <p class="fade-in [--fade-delay:90ms] pt-4 font-mono text-(--color-text-muted)">{data.description}</p>

    <div class="flex flex-wrap gap-2 pt-6">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} target={link.target} />
      ))}
    </div>

    <div class="flex flex-col gap-16 pt-16">
      {projects.map((project, index) => project.data.demo === 'fft' ? (
        <Reveal>
          <div id={project.id} class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8 lg:items-center" data-fft-demo>
            <div class="fft-demo-shell my-0 lg:col-span-2" data-fft-stage>
              {fftPoster && <Image src={fftPoster} alt={project.data.title} width={1200} height={630} format="avif" class="fft-demo-poster" />}
              <div class="fft-demo-overlay flex flex-col gap-20 pb-20 items-center">
                <span class="fft-demo-caption text-md sm:text-lg">Interactive demo — press play to listen</span>
                <button type="button" class="fft-demo-play" data-fft-play aria-label="Play the interactive demo">
                  <Icon name="lucide:play" class="size-5 translate-x-0.5" />
                </button>
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <span class="font-mono text-xs text-(--color-text-muted)">{project.data.date.getUTCFullYear()}</span>
              <h2 class="text-lg font-semibold">{project.data.title}</h2>
              <p class="text-sm text-(--color-text-muted)">{project.data.description}</p>
              <div class="flex flex-wrap gap-2 pt-2">
                {project.data.code && (
                  <Button label="View code" to={project.data.code} target="_blank" icon="i-simple-icons-github" variant="outline" size="sm" />
                )}
                {project.data.website && (
                  <Button label="View website" to={project.data.website} target="_blank" icon="i-lucide-arrow-up-right" variant="outline" size="sm" />
                )}
              </div>
              <Fragment set:html={fftControlsHtml()} />
            </div>
          </div>
        </Reveal>
      ) : (
        <Reveal>
        <div
          id={project.id}
          class:list={['flex flex-col gap-4 sm:gap-8 sm:items-center', index % 2 === 1 ? 'sm:flex-row-reverse' : 'sm:flex-row']}
        >
          <a
            href={project.data.website}
            target={project.data.website ? '_blank' : undefined}
            rel={project.data.website ? 'noopener noreferrer' : undefined}
            tabindex="-1"
            aria-hidden="true"
            class="sm:w-1/2 shrink-0"
          >
            {project.data.video ? (
              <div class="video-shell" data-project-video>
                {cardImages[index] && <Image src={cardImages[index]!} alt={project.data.title} width={640} height={192} format="avif" class="video-poster" />}
                <video muted loop playsinline preload="none" aria-hidden="true" width="640" height="192" class="video-el">
                  <source src={project.data.image.replace(/\.mp4$/, '.webm')} type="video/webm" />
                  <source src={project.data.image} type="video/mp4" />
                </video>
              </div>
            ) : cardImages[index] && (
              <Image
                src={cardImages[index]!}
                alt={project.data.title}
                width={640}
                height={192}
                format="avif"
                loading="lazy"
                class="object-cover w-full h-48 rounded-lg border border-(--color-border)"
              />
            )}
          </a>
          <div class="flex flex-col gap-2">
            <span class="font-mono text-xs text-(--color-text-muted)">{project.data.date.getUTCFullYear()}</span>
            <h2 class="text-lg font-semibold">{project.data.title}</h2>
            <p class="text-sm text-(--color-text-muted)">{project.data.description}</p>
            <div class="flex flex-wrap gap-2 pt-2">
              {project.data.code && (
                <Button label="View code" to={project.data.code} target="_blank" icon="i-simple-icons-github" variant="outline" size="sm" />
              )}
              {project.data.website && (
                <Button label="View website" to={project.data.website} target="_blank" icon="i-lucide-arrow-up-right" variant="outline" size="sm" />
              )}
            </div>
          </div>
        </div>
        </Reveal>
      ))}
    </div>
  </section>
</Base>

<script src="../scripts/fft-demo.ts"></script>
<script src="../scripts/video.ts"></script>
