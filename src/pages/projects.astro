---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import Button from '../components/Button.astro'
import Reveal from '../components/Reveal.astro'
import { localImage } from '../lib/images'
import { getPage } from '../lib/content'
import { fftControlsHtml } from '../lib/fft-demo'

const { data } = await getPage('projects')

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const fftPoster = await localImage('/images/fft-demo-poster.png')
const videoPoster = await localImage('/images/projects/vue-audiomotion-analyzer-poster.png')

const cardImages = await Promise.all(
  projects.map(async (project) => (project.data.video ? undefined : await localImage(project.data.image))),
)

const logoIds = new Set(['wpnuxt', 'harmonics'])
---

<Base title={data.title} description={data.description} path="/projects">
  <Masthead label="projects" title={data.title} description={data.description}>
    <Fragment slot="actions">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} target={link.target} />
      ))}
    </Fragment>
  </Masthead>

  {projects.map((project, index) => {
    const reversed = index % 2 === 1
    const isFft = project.data.demo === 'fft'
    return (
      <Reveal>
        <div class="grid lg:grid-cols-12 border-b border-(--color-border)" {...(isFft ? { 'data-fft-demo': '' } : {})}>
          <div class:list={['lg:col-span-5 p-6 lg:p-10 flex flex-col gap-4 justify-center', reversed ? 'lg:order-2' : 'lg:order-1']}>
            <span class="label text-(--color-text-dimmed)">{project.data.date.getUTCFullYear()}</span>
            <h2 class="text-2xl font-semibold tracking-tight">{project.data.title}</h2>
            <p class="text-base text-(--color-text-muted)">{project.data.description}</p>
            <div class="flex flex-wrap gap-3">
              {project.data.code && (
                <Button label="View code" to={project.data.code} target="_blank" icon="i-simple-icons-github" variant="outline" size="sm" />
              )}
              <Button label="View website" to={project.data.website} target="_blank" icon="i-lucide-arrow-up-right" variant="outline" size="sm" />
            </div>
            {isFft && <div class="mt-auto pt-6" set:html={fftControlsHtml()} />}
          </div>
          <div
            class:list={[
              'lg:col-span-7 border-t lg:border-t-0 min-h-64',
              // The demo keeps the canvas aspect ratio rather than filling the
              // cell, so centre it in whatever height the text column sets.
              isFft ? 'flex items-center' : '',
              reversed ? 'lg:order-1 lg:border-r border-(--color-border)' : 'lg:order-2 lg:border-l border-(--color-border)',
            ]}
          >
            {isFft ? (
              <div class="fft-demo-shell" data-fft-stage>
                {fftPoster && <Image src={fftPoster} alt={project.data.title} width={1200} height={630} format="avif" class="fft-demo-poster" />}
                <div class="fft-demo-overlay">
                  <button type="button" class="fft-demo-play" data-fft-play aria-label="Play the interactive demo">
                    <Icon name="lucide:play" class="size-5 translate-x-0.5" />
                  </button>
                  <span class="fft-demo-caption">Interactive demo — press play to listen</span>
                </div>
              </div>
            ) : project.data.video ? (
              <div class="video-shell" data-project-video>
                {videoPoster && <Image src={videoPoster} alt={project.data.title} width={640} height={192} format="avif" class="video-poster" />}
                <video muted loop playsinline preload="none" aria-hidden="true" width="640" height="192" class="video-el">
                  <source src={project.data.image.replace(/\.mp4$/, '.webm')} type="video/webm" />
                  <source src={project.data.image} type="video/mp4" />
                </video>
              </div>
            ) : cardImages[index] && (
              <Image
                src={cardImages[index]!}
                alt={project.data.title}
                {...(logoIds.has(project.id) ? { width: 640 } : { width: 640, height: 192 })}
                format="avif"
                loading="lazy"
                class:list={['w-full h-full min-h-64', logoIds.has(project.id) ? 'object-contain p-8' : 'object-cover']}
              />
            )}
          </div>
        </div>
      </Reveal>
    )
  })}
</Base>

<script src="../scripts/fft-demo.ts"></script>
<script src="../scripts/video.ts"></script>
