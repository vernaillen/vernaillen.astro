---
import { getCollection, getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import Reveal from '../components/Reveal.astro'
import { localImage } from '../lib/images'
import { fftControlsHtml } from '../lib/fft-demo'
import type { LinksPage } from '../content.config'

const page = await getEntry('pages', 'projects')
const data = page!.data as LinksPage

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const fftPoster = await localImage('/images/fft-demo-poster.png')
const videoPoster = await localImage('/images/projects/vue-audiomotion-analyzer-poster.png')

const cardImages = await Promise.all(
  projects.map(async (project) => (project.data.video ? undefined : await localImage(project.data.image))),
)
---

<Base title={data.title} description={data.description} path="/projects">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="text-3xl sm:text-5xl tracking-tight">{data.title}</h1>
    <p class="pt-4 font-mono text-(--color-text-muted)">{data.description}</p>

    <div class="flex flex-wrap gap-2 pt-6">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} target={link.target} />
      ))}
    </div>

    <div class="flex flex-col gap-16 pt-16">
      {projects.map((project, index) => project.data.demo === 'fft' ? (
        <Reveal class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-x-8 sm:items-center">
          {/* The stage and its controls are separate grid rows so the text centres on the stage alone. */}
          <div class="contents" data-fft-demo>
            <div class="fft-demo-shell my-0 sm:col-span-2" data-fft-stage>
              {fftPoster && <Image src={fftPoster} alt={project.data.title} width={1200} height={630} format="avif" class="fft-demo-poster" />}
              <div class="fft-demo-overlay">
                <button type="button" class="fft-demo-play" data-fft-play aria-label="Play the interactive demo">
                  <Icon name="lucide:play" class="size-5 translate-x-0.5" />
                </button>
                <span class="fft-demo-caption">Interactive demo — press play to listen</span>
              </div>
            </div>
            <Fragment set:html={fftControlsHtml('sm:col-span-2')} />
          </div>
          <div class="flex flex-col gap-2 sm:col-start-3 sm:row-start-1">
            <span class="font-mono text-xs text-(--color-text-muted)">{project.data.date.getUTCFullYear()}</span>
            <h2 class="text-lg font-semibold">{project.data.title}</h2>
            <p class="text-sm text-(--color-text-muted)">{project.data.description}</p>
            <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1 text-sm text-vernaillen-500">
              View Project
              <Icon name="lucide:arrow-right" class="size-4 transition-transform opacity-0 group-hover:translate-x-1 group-hover:opacity-100" />
            </a>
          </div>
        </Reveal>
      ) : (
        <Reveal>
        <a
          href={project.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['group flex flex-col gap-4 sm:gap-8 sm:items-center', index % 2 === 1 ? 'sm:flex-row-reverse' : 'sm:flex-row']}
        >
          <div class="sm:w-1/2 shrink-0">
            {project.data.video ? (
              <div class="video-shell" data-project-video>
                {videoPoster && <Image src={videoPoster} alt={project.data.title} width={640} height={192} format="avif" class="video-poster" />}
                <video muted loop playsinline preload="none" aria-hidden="true" width="640" height="192" class="video-el">
                  <source src={project.data.image.replace(/\.mp4$/, '.webm')} type="video/webm" />
                  <source src={project.data.image} type="video/mp4" />
                </video>
              </div>
            ) : cardImages[index] && (
              <Image
                src={cardImages[index]!}
                alt={project.data.title}
                width={640}
                height={192}
                format="avif"
                loading="lazy"
                class="object-cover w-full h-48 rounded-lg border border-(--color-border)"
              />
            )}
          </div>
          <div class="flex flex-col gap-2">
            <span class="font-mono text-xs text-(--color-text-muted)">{project.data.date.getUTCFullYear()}</span>
            <h2 class="text-lg font-semibold">{project.data.title}</h2>
            <p class="text-sm text-(--color-text-muted)">{project.data.description}</p>
            <span class="inline-flex items-center gap-1 text-sm text-vernaillen-500">
              View Project
              <Icon name="lucide:arrow-right" class="size-4 transition-transform opacity-0 group-hover:translate-x-1 group-hover:opacity-100" />
            </span>
          </div>
        </a>
        </Reveal>
      ))}
    </div>
  </section>
</Base>

<script src="../scripts/fft-demo.ts"></script>
<script src="../scripts/video.ts"></script>
