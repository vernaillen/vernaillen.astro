---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Base from '../../layouts/Base.astro'
import JsonLd from '../../components/JsonLd.astro'
import { formatPostDate, sortPostsNewestFirst } from '../../lib/date'
import { localImage } from '../../lib/images'
import { site, ogImagePath } from '../../lib/site'
import { resolveIcon } from '../../lib/icons'

export async function getStaticPaths() {
  const posts = sortPostsNewestFirst(await getCollection('blog'))
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: posts[index - 1], next: posts[index + 1] },
  }))
}

const { post, prev, next } = Astro.props
const { Content, headings } = await render(post)
const image = await localImage(post.data.image.src)
const authorAvatar = await localImage(post.data.author.avatar.src)
const articleLink = new URL(`/blog/${post.id}`, site.url).toString()

const socialIcons: Record<string, string> = {
  mastodon: 'simple-icons:mastodon',
  x: 'simple-icons:x',
  bluesky: 'simple-icons:bluesky',
  linkedin: 'simple-icons:linkedin',
  github: 'simple-icons:github',
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(ogImagePath(`/blog/${post.id}`), site.url).toString(),
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author.name },
}
---

<Base title={post.data.title} description={post.data.description} path={`/blog/${post.id}`} type="article" publishedTime={post.data.date.toISOString()}>
  <JsonLd data={articleSchema} />

  <div class="border-b border-(--color-border) p-6 lg:p-10 flex flex-col gap-4">
    <a href="/blog" class="w-fit font-mono uppercase text-xs tracking-[0.08em] text-(--color-text-muted) hover:text-(--color-accent-text) transition-colors">
      &larr; blog
    </a>
    <p class="label text-(--color-text-dimmed)">{formatPostDate(post.data.date)} &middot; {post.data.minRead} min read</p>
    <h1 class="masthead max-w-4xl">{post.data.title}</h1>
    <p class="text-lg text-(--color-text-muted) max-w-3xl">{post.data.description}</p>
    <div class="flex items-center gap-3 pt-2">
      {authorAvatar && <Image src={authorAvatar} alt={post.data.author.avatar.alt} width={36} height={36} class="size-9 object-cover" />}
      <div class="text-sm">
        <p class="font-medium text-(--color-text)">{post.data.author.name}</p>
        <p class="font-mono text-xs text-(--color-text-muted)">{post.data.author.description}</p>
      </div>
    </div>
  </div>

  {image && (
    <Image
      src={image}
      alt={post.data.title}
      width={1600}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 80rem) 80rem, 100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="aspect-[21/9] w-full object-cover border-b border-(--color-border)"
    />
  )}

  <div class="grid min-w-0 lg:grid-cols-12">
    <article class="blog-prose min-w-0 w-full lg:col-span-9 max-w-3xl p-6 lg:p-10">
      <Content />

      {post.data.social && post.data.social.length > 0 && (
        <div class="mt-10 pt-6 border-t border-(--color-border)">
          <p class="text-sm text-(--color-text-muted)">Got thoughts on this post? Join the conversation:</p>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {post.data.social.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Join the conversation on ${s.name}`} class="inline-flex items-center justify-center size-8 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-accent-text) transition-colors">
                <Icon name={s.icon ? resolveIcon(s.icon) : (socialIcons[s.name] ?? `simple-icons:${s.name}`)} class="size-4" />
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="flex items-center justify-end gap-2 mt-10 pt-6 border-t border-(--color-border)">
        <span class="label text-(--color-text-muted) mr-1">share /</span>
        <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleLink)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="inline-flex size-8 items-center justify-center border border-(--color-border) hover:text-(--color-accent-text) transition-colors">
          <Icon name="simple-icons:x" class="size-3.5" />
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleLink)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="inline-flex size-8 items-center justify-center border border-(--color-border) hover:text-(--color-accent-text) transition-colors">
          <Icon name="simple-icons:linkedin" class="size-3.5" />
        </a>
        <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.data.title} ${articleLink}`)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky" class="inline-flex size-8 items-center justify-center border border-(--color-border) hover:text-(--color-accent-text) transition-colors">
          <Icon name="simple-icons:bluesky" class="size-3.5" />
        </a>
        <button type="button" data-copy-link={articleLink} aria-label="Copy link" class="copy-btn inline-flex size-8 items-center justify-center border border-(--color-border) hover:text-(--color-accent-text) transition-colors">
          <Icon name="lucide:link" class="icon-copy size-3.5" />
          <Icon name="lucide:check" class="icon-check size-3.5" />
        </button>
      </div>

      {(prev || next) && (
        <div class="grid sm:grid-cols-2 mt-6 pt-6 border-t border-(--color-border) gap-6">
          {prev && (
            <a href={`/blog/${prev.id}`} class="group flex flex-col gap-1">
              <p class="text-xs text-(--color-text-dimmed)">&larr; Newer</p>
              <p class="text-base font-medium group-hover:text-(--color-accent-text) transition-colors">{prev.data.title}</p>
              <p class="text-sm text-(--color-text-muted) line-clamp-2">{prev.data.description}</p>
            </a>
          )}
          {next && (
            <a
              href={`/blog/${next.id}`}
              class:list={[
                'group flex flex-col gap-1 sm:text-right sm:items-end',
                !prev && 'sm:col-start-2',
              ]}
            >
              <p class="text-xs text-(--color-text-dimmed)">Older &rarr;</p>
              <p class="text-base font-medium group-hover:text-(--color-accent-text) transition-colors">{next.data.title}</p>
              <p class="text-sm text-(--color-text-muted) line-clamp-2">{next.data.description}</p>
            </a>
          )}
        </div>
      )}
    </article>

    {headings.length > 0 && (
      <nav id="toc" class="hidden lg:block lg:col-span-3 lg:border-l border-(--color-border) p-6 lg:p-8 sticky top-20 self-start text-sm">
        <p class="label text-(--color-text-dimmed) mb-3">Contents</p>
        <ul class="flex flex-col gap-2">
          {headings.filter((h) => h.depth <= 3).map((heading) => (
            <li style={{ paddingLeft: `${(heading.depth - 2) * 0.75}rem` }}>
              <a href={`#${heading.slug}`} data-toc-link class="block border-l-2 border-transparent pl-3 -ml-px text-(--color-text-muted) hover:text-(--color-text) transition-colors">{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Base>

<script src="../../scripts/copy-code.ts"></script>
<script src="../../scripts/copy-link.ts"></script>
<script src="../../scripts/toc.ts"></script>
{post.body?.includes('::fft-visualizer-demo') && <script src="../../scripts/fft-demo.ts"></script>}
