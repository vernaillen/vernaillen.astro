---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Base from '../../layouts/Base.astro'
import JsonLd from '../../components/JsonLd.astro'
import TocList from '../../components/TocList.astro'
import { formatPostDate } from '../../lib/date'
import { localImage } from '../../lib/images'
import { site, ogImagePath } from '../../lib/site'
import { resolveIcon } from '../../lib/icons'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: posts[index + 1], next: posts[index - 1] },
  }))
}

const { post, prev, next } = Astro.props
const { Content, headings } = await render(post)
const tocHeadings = headings.filter((h) => h.depth <= 3)
const image = await localImage(post.data.image.src)
const authorAvatar = await localImage(post.data.author.avatar.src)
const articleLink = new URL(`/blog/${post.id}`, site.url).toString()

const socialNetworks: Record<string, { icon: string; label: string }> = {
  mastodon: { icon: 'simple-icons:mastodon', label: 'Mastodon' },
  x: { icon: 'simple-icons:x', label: 'X' },
  bluesky: { icon: 'simple-icons:bluesky', label: 'Bluesky' },
  linkedin: { icon: 'simple-icons:linkedin', label: 'LinkedIn' },
  github: { icon: 'simple-icons:github', label: 'GitHub' },
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(ogImagePath(`/blog/${post.id}`), site.url).toString(),
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author.name },
}
---

<Base title={post.data.title} description={post.data.description} path={`/blog/${post.id}`} type="article" publishedTime={post.data.date.toISOString()}>
  <JsonLd data={articleSchema} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16">
    <a href="/blog" data-astro-prefetch class="font-mono text-xs text-(--color-text-muted) flex items-center gap-1.5 hover:text-(--color-text) transition-colors">
      <span class="text-vernaillen-500/70">&gt;_</span>
      <span>blog</span>
    </a>

    <div class="flex flex-col gap-4 mt-8">
      <div class="flex items-center justify-center gap-3 font-mono text-xs text-(--color-text-muted)">
        <span>{formatPostDate(post.data.date)}</span>
        <span class="text-vernaillen-500/50">//</span>
        <span>{post.data.minRead} min read</span>
      </div>

      <h1 class="text-3xl sm:text-4xl text-center mx-auto leading-tight">{post.data.title}</h1>
      <p class="font-mono text-(--color-text-muted) text-center mx-auto text-base leading-relaxed">{post.data.description}</p>

      {image && (
        <Image
          src={image}
          alt={post.data.title}
          width={900}
          height={post.data.image.height ?? 300}
          format="avif"
          loading="eager"
          fetchpriority="high"
          style={{ height: `${post.data.image.height ?? 300}px` }}
          class="rounded-lg w-full object-cover object-center border border-(--color-border)"
        />
      )}

      <div class="flex items-center justify-center gap-3 pt-2">
        {authorAvatar && <Image src={authorAvatar} alt={post.data.author.avatar.alt} width={36} height={36} class="size-9 rounded-full object-cover" />}
        <div class="text-sm text-left">
          <p class="font-medium">{post.data.author.name}</p>
          <p class="text-(--color-text-muted) text-xs">{post.data.author.description}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 pb-20 grid gap-10 lg:grid-cols-10 lg:items-start">
    {tocHeadings.length > 0 && (
      <details class="lg:hidden rounded-lg border border-(--color-border) px-4 py-3 text-sm">
        <summary class="cursor-pointer font-mono text-xs uppercase tracking-wide text-(--color-text-muted)">On this page</summary>
        <div class="mt-3">
          <TocList headings={tocHeadings} />
        </div>
      </details>
    )}

    <article class="blog-prose min-w-0 lg:col-span-8">
      <Content />

      {post.data.social && post.data.social.length > 0 && (
        <div class="mt-10 rounded-lg border border-vernaillen-500/25 bg-vernaillen-500/5 p-3">
          <p class="flex items-center gap-1.5 font-mono text-xs text-(--color-accent)">
            <Icon name="lucide:message-square-text" class="size-4 shrink-0" />
            comment //
          </p>
          <p class="mt-1.5 text-xs text-(--color-text-muted) leading-snug">Got thoughts on this post? Join the conversation:</p>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {post.data.social.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Join the conversation on ${socialNetworks[s.name]?.label ?? s.name}`}
                class="inline-flex items-center justify-center rounded-md bg-vernaillen-500/10 hover:bg-vernaillen-500/20 transition-colors size-8 text-(--color-accent)"
              >
                <Icon name={s.icon ? resolveIcon(s.icon) : (socialNetworks[s.name]?.icon ?? `simple-icons:${s.name}`)} class="size-4" />
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="flex items-center justify-end gap-2 mt-10 pt-6 border-t border-(--color-border)">
        <span class="font-mono text-xs text-(--color-text-muted) mr-1">share //</span>
        <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleLink)}`} aria-label="Share on X" target="_blank" rel="noopener noreferrer" class="inline-flex size-8 items-center justify-center rounded-md border border-(--color-border) hover:bg-(--color-bg-muted) transition-colors">
          <Icon name="simple-icons:x" class="size-3.5" />
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleLink)}`} aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer" class="inline-flex size-8 items-center justify-center rounded-md border border-(--color-border) hover:bg-(--color-bg-muted) transition-colors">
          <Icon name="simple-icons:linkedin" class="size-3.5" />
        </a>
        <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.data.title} ${articleLink}`)}`} aria-label="Share on Bluesky" target="_blank" rel="noopener noreferrer" class="inline-flex size-8 items-center justify-center rounded-md border border-(--color-border) hover:bg-(--color-bg-muted) transition-colors">
          <Icon name="simple-icons:bluesky" class="size-3.5" />
        </a>
        <button type="button" data-copy-link={articleLink} aria-label="Copy link" class="copy-btn inline-flex size-8 items-center justify-center rounded-md border border-(--color-border) hover:bg-(--color-bg-muted) transition-colors">
          <Icon name="lucide:link" class="icon-copy size-3.5" />
          <Icon name="lucide:check" class="icon-check size-3.5" />
        </button>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 pt-6">
        {prev && (
          <a href={`/blog/${prev.id}`} data-astro-prefetch class="card-glow rounded-lg border border-(--color-border) p-4">
            <p class="font-mono text-xs text-(--color-text-muted)">&larr; Previous</p>
            <p class="text-sm mt-1">{prev.data.title}</p>
            <p class="text-xs text-(--color-text-muted) line-clamp-2 mt-1">{prev.data.description}</p>
          </a>
        )}
        {next && (
          <a href={`/blog/${next.id}`} data-astro-prefetch class:list={['card-glow rounded-lg border border-(--color-border) p-4', !prev && 'sm:col-start-2']}>
            <p class="font-mono text-xs text-(--color-text-muted) text-right">Next &rarr;</p>
            <p class="text-sm mt-1 text-right">{next.data.title}</p>
            <p class="text-xs text-(--color-text-muted) line-clamp-2 mt-1 text-right">{next.data.description}</p>
          </a>
        )}
      </div>
    </article>

    {tocHeadings.length > 0 && (
      <nav id="toc" class="hidden lg:block lg:col-span-2 sticky top-24 text-sm">
        <p class="font-mono text-xs uppercase tracking-wide text-(--color-text-muted) mb-2">On this page</p>
        <TocList headings={tocHeadings} />
      </nav>
    )}
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Enlarged image">
    <div class="flex h-full w-full items-center justify-center p-4" data-lightbox-stage>
      <img alt="" data-lightbox-image />
    </div>
    <button
      type="button"
      data-lightbox-close
      aria-label="Close"
      class="absolute right-4 top-4 inline-flex size-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    >
      <Icon name="lucide:x" class="size-4" />
    </button>
  </dialog>
</Base>

<script src="../../scripts/copy-code.ts"></script>
<script src="../../scripts/copy-link.ts"></script>
<script src="../../scripts/toc.ts"></script>
<script src="../../scripts/lightbox.ts"></script>
{post.body?.includes('::fft-visualizer-demo') && <script src="../../scripts/fft-demo.ts"></script>}
