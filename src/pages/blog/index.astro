---
import { getCollection, getEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import BlogPostCard from '../../components/BlogPostCard.astro'
import type { BlogMeta } from '../../content.config'

const page = await getEntry('pages', 'blog')
const data = page!.data as BlogMeta

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Base title={data.title} description={data.description} path="/blog">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 sm:py-24">
    <Eyebrow index="01" label="blog" />
    <h1 class="pt-2 text-3xl sm:text-5xl tracking-tight">{data.title}</h1>
    <p class="pt-4 text-(--color-text-muted) max-w-2xl">{data.description}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-12">
      {posts.map((post, index) => (
        <BlogPostCard post={post} orientation="vertical" eager={index === 0} />
      ))}
    </div>
  </section>
</Base>
