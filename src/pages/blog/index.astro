---
import { getCollection, getEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import BlogPostCard from '../../components/BlogPostCard.astro'
import type { BlogMeta } from '../../content.config'

const page = await getEntry('pages', 'blog')
const data = page!.data as BlogMeta

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Base title={data.title} description={data.description} path="/blog">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <h1 class="fade-in text-3xl sm:text-5xl">{data.title}</h1>
    <p class="fade-in [--fade-delay:90ms] pt-4 font-mono text-(--color-text-muted)">{data.description}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-12">
      {posts.map((post, index) => (
        <BlogPostCard post={post} orientation="vertical" eager={index === 0} headingLevel="h2" />
      ))}
    </div>
  </section>
</Base>
