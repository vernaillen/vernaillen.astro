---
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Button from '../components/Button.astro'
import type { CareerPage } from '../content.config'

const page = await getEntry('pages', 'career')
const data = page!.data as CareerPage

const CATEGORY_ORDER = ['Open Source', 'Freelance', 'Employed'] as const
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  events: data.events.filter((event) => event.category === category),
}))
---

<Base title={data.title} description={data.description} path="/career">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16 sm:py-24">
    <Eyebrow index="01" label="career" />
    <h1 class="pt-2 text-3xl sm:text-5xl tracking-tight">{data.title}</h1>
    <p class="pt-4 text-(--color-text-muted) max-w-2xl">{data.description}</p>

    <div class="grid gap-10 lg:grid-cols-3 pt-14">
      {groups.map((group) => (
        <div class="flex flex-col gap-6">
          <h2 class="sticky top-20 font-mono text-xs uppercase tracking-wide text-vernaillen-500 bg-(--color-bg)/80 backdrop-blur-sm py-1">
            {group.category}
          </h2>
          <div class="flex flex-col gap-8">
            {group.events.map((event) => (
              <div class="border-l-2 border-(--color-border) pl-4 flex flex-col gap-1.5">
                <p class="font-mono text-xs text-(--color-text-muted)">{event.location} <span class="text-vernaillen-500/60">//</span> {event.date}</p>
                <h3 class="text-sm font-medium leading-snug">{event.title}</h3>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {event.stack.map((tech) => (
                    <span class="rounded border border-(--color-border) px-1.5 py-0.5 font-mono text-[0.65rem] text-(--color-text-muted)">{tech}</span>
                  ))}
                </div>
                {event.links && (
                  <div class="flex flex-wrap gap-2 pt-2">
                    {event.links.map((link) => (
                      <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size ?? 'xs'} target={link.target} />
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap gap-2 pt-16">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size} target={link.target} />
      ))}
    </div>
  </section>
</Base>
