---
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import Reveal from '../components/Reveal.astro'
import type { CareerPage } from '../content.config'

const page = await getEntry('pages', 'career')
const data = page!.data as CareerPage

const CATEGORY_ORDER = ['Open Source', 'Freelance', 'Employed'] as const
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  events: data.events.filter((event) => event.category === category),
}))
---

<Base title={data.title} description={data.description} path="/career">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24">
    <h1 class="fade-in text-3xl sm:text-5xl">{data.title}</h1>
    <p class="fade-in [--fade-delay:90ms] pt-4 font-mono text-(--color-text-muted)">{data.description}</p>
    <div class="flex flex-wrap gap-2 pt-6">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size} target={link.target} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-16 sm:pb-24 flex flex-col gap-16">
    {groups.map((group) => (
      <div class="grid grid-cols-1 lg:grid-cols-3 lg:gap-4">
        <div class="mb-2 lg:mb-0">
          <h2 class="lg:sticky lg:top-20 text-xl font-semibold">{group.category}</h2>
        </div>
        <div class="lg:col-span-2 space-y-8">
          {group.events.map((event) => (
            <Reveal>
              <div class="pl-6 border-l border-(--color-border)">
                <p class="mb-1 text-sm font-medium text-(--color-text-muted)">{event.location}<span class="mx-1">&middot;</span>{event.date}</p>
                <h3 class="text-lg font-semibold">{event.title}</h3>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {event.stack.map((tech) => (
                    <span class="inline-flex items-center rounded-lg bg-vernaillen-500/10 px-1.5 py-1 text-[10px]/3 font-medium text-(--color-accent)">{tech}</span>
                  ))}
                </div>
              </div>
              {event.links && (
                <div class="mt-2 pl-6 flex flex-wrap gap-2">
                  {event.links.map((link) => (
                    <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size} target={link.target} />
                  ))}
                </div>
              )}
            </Reveal>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>
