---
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import Button from '../components/Button.astro'
import { getPage } from '../lib/content'

const { data } = await getPage('career')

const CATEGORY_ORDER = ['Open Source', 'Freelance', 'Employed'] as const
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  events: data.events.filter((event) => event.category === category),
}))
---

<Base title={data.title} description={data.description} path="/career">
  <Masthead label="career" title={data.title} description={data.description}>
    <Fragment slot="actions">
      {data.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size} target={link.target} />
      ))}
    </Fragment>
  </Masthead>

  <div class="grid lg:grid-cols-3 gap-10 p-6 lg:p-10 border-b border-(--color-border)">
    {groups.map((group) => (
      <div class="flex flex-col">
        <h2 class="text-sm font-medium text-(--color-text) pb-4 border-b border-(--color-border)">
          {group.category}
        </h2>
        <div class="flex flex-col">
          {group.events.map((event, i) => (
            <div class:list={['flex flex-col gap-1.5 py-5', i === 0 ? '' : 'border-t border-(--color-border)']}>
              <p class="text-xs font-mono text-(--color-text-muted)">{event.location} &middot; {event.date}</p>
              <h3 class="text-base font-medium text-(--color-text)">{event.title}</h3>
              {event.stack.length > 0 && (
                <p class="text-sm text-(--color-text-dimmed)">{event.stack.join(' · ')}</p>
              )}
              {event.links && (
                <div class="flex flex-wrap gap-2 pt-2">
                  {event.links.map((link) => (
                    <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant ?? 'outline'} size={link.size ?? 'xs'} target={link.target} />
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</Base>
