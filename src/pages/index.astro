---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Reveal from '../components/Reveal.astro'
import Hero from '../components/home/Hero.astro'
import SelectedWork from '../components/home/SelectedWork.astro'
import About from '../components/home/About.astro'
import WorkExperience from '../components/home/WorkExperience.astro'
import Blog from '../components/home/Blog.astro'
import Testimonials from '../components/home/Testimonials.astro'
import Faq from '../components/home/Faq.astro'
import { getPage } from '../lib/content'
import { sortPostsNewestFirst } from '../lib/date'

const { data } = await getPage('index')

const posts = sortPostsNewestFirst(await getCollection('blog')).slice(0, 3)
---

<Base title={data.seo.title} description={data.seo.description} path="/">
  <Hero data={data} />

  <Reveal>
    <SelectedWork data={data} />
  </Reveal>

  <Reveal>
    <About data={data} />
  </Reveal>

  <Reveal>
    <WorkExperience data={data} />
  </Reveal>

  <Reveal>
    <Blog data={data} posts={posts} />
  </Reveal>

  <Reveal>
    <Testimonials data={data} />
  </Reveal>

  <Reveal>
    <Faq data={data} />
  </Reveal>
</Base>
