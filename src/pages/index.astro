---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import Reveal from '../components/Reveal.astro'
import Hero from '../components/home/Hero.astro'
import Stats from '../components/home/Stats.astro'
import About from '../components/home/About.astro'
import WorkExperience from '../components/home/WorkExperience.astro'
import Blog from '../components/home/Blog.astro'
import Testimonials from '../components/home/Testimonials.astro'
import Faq from '../components/home/Faq.astro'
import Toolbox from '../components/Toolbox.astro'
import SectionHeading from '../components/SectionHeading.astro'
import type { IndexPage, ToolboxPage } from '../content.config'

const page = await getEntry('pages', 'index')
const data = page!.data as IndexPage
const toolboxPage = await getEntry('pages', 'toolbox')
const toolbox = toolboxPage!.data as ToolboxPage

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
---

<Base title={data.seo.title} description={data.seo.description} path="/">
  <Hero data={data} />

  <Stats data={data} />

  <Reveal class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 flex flex-col gap-8 section-divider">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
      <SectionHeading title={toolbox.title} description={toolbox.description} />
      <a href="/about#toolbox" data-astro-prefetch class="shrink-0 font-mono text-sm text-(--color-accent) hover:underline underline-offset-4">Full toolbox &rarr;</a>
    </div>
    <Toolbox data={toolbox} compact />
  </Reveal>

  <Reveal class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid gap-16 lg:grid-cols-2 lg:gap-12 section-divider">
    <About data={data} />
    <WorkExperience data={data} />
  </Reveal>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 section-divider">
    <Blog data={data} posts={posts} />
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 section-divider">
    <Testimonials data={data} />
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 section-divider">
    <Faq data={data} />
  </div>
</Base>
