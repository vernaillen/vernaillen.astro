---
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
import { navLinks } from '../lib/links'

const links = navLinks.filter((link) => ['/', '/blog', '/projects'].includes(link.href))
---

<Base title="Page not found" description="We are sorry but this page could not be found." path="/404">
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <p class="fade-in font-mono text-xs text-(--color-text-muted)">
      404 <span class="text-vernaillen-500/60">//</span> page not found
    </p>
    <h1 class="fade-in [--fade-delay:40ms] pt-4 text-3xl sm:text-5xl">This page does not exist</h1>
    <p class="fade-in [--fade-delay:90ms] pt-4 max-w-xl font-mono text-(--color-text-muted)">
      The link may be outdated, or the page has moved. Try one of these instead.
    </p>

    <div class="fade-in [--fade-delay:140ms] flex flex-wrap gap-2 pt-6">
      {links.map((link, index) => (
        <Button label={link.label} to={link.href} icon={link.icon} variant={index === 0 ? 'solid' : 'outline'} />
      ))}
    </div>
  </section>
</Base>
