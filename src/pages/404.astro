---
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import Button from '../components/Button.astro'
---

<Base title="Page not found" description="We are sorry but this page could not be found." path="/404" noindex>
  <Masthead label="not found" title="Page not found" description="We are sorry but this page could not be found.">
    <Fragment slot="actions">
      <Button label="Back home" to="/" variant="solid" />
    </Fragment>
  </Masthead>
</Base>
