---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import type { CollectionEntry } from 'astro:content'
import { formatPostDate } from '../lib/date'
import { localImage } from '../lib/images'

interface Props {
  post: CollectionEntry<'blog'>
  showImage?: boolean
  eager?: boolean
  first?: boolean
}
const { post, showImage = false, eager = false, first = false } = Astro.props
const image = showImage ? await localImage(post.data.image.src) : undefined
const logoImageIds = new Set(['wpnuxt-whats-new', 'wpnuxt-v2', 'discoveringnuxt', 'hello-world-vernaillen-dev'])
const isLogo = logoImageIds.has(post.id)
const imageDims = isLogo ? { width: 192 } : { width: 192, height: 120 }
---

<a
  href={`/blog/${post.id}`}
  class:list={[
    'group grid items-center gap-x-6 py-5 px-5 sm:px-8 transition-colors hover:bg-(--color-bg-muted)',
    first ? '' : 'border-t border-(--color-border)',
    showImage ? 'grid-cols-[1fr_auto] lg:grid-cols-[1fr_12rem]' : 'grid-cols-[1fr_auto]',
  ]}
>
  <div class="flex flex-col gap-1.5 min-w-0">
    <h3 class="text-xl font-medium tracking-tight group-hover:text-(--color-accent-text) transition-colors">{post.data.title}</h3>
    <p class="text-sm text-(--color-text-muted) line-clamp-2">{post.data.description}</p>
    <p class="label text-(--color-text-dimmed)">{formatPostDate(post.data.date)} &middot; {post.data.minRead} min read</p>
  </div>
  {showImage && image ? (
    <Image
      src={image}
      alt={post.data.image.alt ?? post.data.title}
      {...imageDims}
      format="avif"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class:list={['hidden lg:block aspect-[16/10] w-48 h-auto self-center', isLogo ? 'object-contain p-2' : 'object-cover']}
    />
  ) : (
    <Icon
      name="lucide:arrow-right"
      class="size-4 text-(--color-text-dimmed) group-hover:text-(--color-accent-text) group-hover:translate-x-1 transition-all self-start mt-1.5 justify-self-end"
    />
  )}
</a>
