---
import { Icon } from 'astro-icon/components'
import { resolveIcon } from '../lib/icons'

interface Props {
  label?: string
  to?: string
  icon?: string
  variant?: string
  size?: string
  target?: string
  class?: string
}

const { label, to, icon, variant = 'solid', size = 'md', target, class: className } = Astro.props
const Tag = to ? 'a' : 'button'

const sizeClasses: Record<string, string> = {
  xs: 'text-xs px-2 py-1 gap-1',
  sm: 'text-sm px-2.5 py-1.5 gap-1.5',
  md: 'text-sm px-3.5 py-2 gap-2',
  lg: 'text-base px-4.5 py-2.5 gap-2',
}

const variantClasses: Record<string, string> = {
  solid: 'bg-vernaillen-500 text-dusk-950 hover:bg-vernaillen-400',
  outline: 'border border-(--color-border) hover:bg-(--color-bg-muted)',
  ghost: 'hover:bg-(--color-bg-muted)',
  soft: 'bg-(--color-bg-muted) hover:bg-(--color-border)',
  subtle: 'ring ring-inset ring-(--color-border) bg-(--color-bg-muted)/60 hover:bg-(--color-bg-muted)',
  link: 'underline-offset-4 hover:underline px-0! py-0!',
}
---

<Tag
  href={to}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center rounded-md font-medium transition-colors',
    sizeClasses[size] ?? sizeClasses.md,
    variantClasses[variant] ?? variantClasses.solid,
    className,
  ]}
>
  {icon && <Icon name={resolveIcon(icon)} class="size-4 shrink-0" />}
  {label && <span>{label}</span>}
  <slot />
</Tag>
