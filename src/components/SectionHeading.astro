---
import Eyebrow from './Eyebrow.astro'

interface Props {
  index?: string
  eyebrow: string
  title: string
  description?: string
  align?: 'left' | 'center'
  class?: string
}
const { index, eyebrow, title, description, align = 'left', class: className } = Astro.props
---

<div class:list={['flex flex-col gap-2', align === 'center' ? 'items-center text-center' : 'items-start text-left', className]}>
  <Eyebrow index={index} label={eyebrow} />
  <h2 class="section-title text-2xl sm:text-2xl lg:text-3xl tracking-tight">{title}</h2>
  {description && <p class="text-sm sm:text-base text-(--color-text-muted) max-w-2xl">{description}</p>}
</div>
