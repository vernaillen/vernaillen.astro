---
import { Icon } from 'astro-icon/components'
import { resolveIcon } from '../lib/icons'
import { navLinks } from '../lib/links'
import { socialLinks, buildDate, formatDeployedAt } from '../lib/site'

const year = buildDate.getUTCFullYear()
const deployedAtLabel = formatDeployedAt(buildDate)
---

<footer class="bg-vernaillen-500 text-dusk-950">
  <div class="page-frame border-dusk-950/20">
    <div class="grid lg:grid-cols-12 border-b border-dusk-950/20">
      <div class="lg:col-span-6 p-8 flex items-center">
        <svg viewBox="0 0 754 276" class="h-24 lg:h-32 w-auto" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
          <path fill="currentColor" class="fill-dusk-950" d="M0 0 H92 V184 H172 V0 H264 V184 H344 V0 H436 V276 H0 Z" />
          <path fill="currentColor" class="fill-dusk-950" d="M490 0 H582 V184 H662 V0 H754 V276 H490 Z" />
        </svg>
      </div>
      <nav class="lg:col-span-3 border-t lg:border-t-0 lg:border-l border-dusk-950/20 p-8 flex flex-col gap-3 font-mono uppercase text-[0.6875rem] tracking-[0.16em]">
        {navLinks.map((link) => (
          <a href={link.href} class="hover:underline underline-offset-4">{link.label}</a>
        ))}
      </nav>
      <div class="lg:col-span-3 border-t lg:border-t-0 lg:border-l border-dusk-950/20 p-8 flex flex-col gap-3 font-mono uppercase text-[0.6875rem] tracking-[0.16em]">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:underline underline-offset-4">
            <Icon name={resolveIcon(link.icon)} class="size-4" />
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="p-8">
      <p class="font-mono text-xs text-dusk-950/85 leading-relaxed">
        Built with Astro &amp; Tailwind CSS, self-hosted on Combell via Bunny CDN.<br />
        last deployed {deployedAtLabel}<br /><br />
        © {year} Wouter Vernaillen · Harmonics BV — VAT BE0503971022
      </p>
    </div>
  </div>
</footer>
