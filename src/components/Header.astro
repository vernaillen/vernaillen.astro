---
import { Icon } from 'astro-icon/components'
import { navLinks, isNavLinkActive } from '../lib/links'
import { resolveIcon } from '../lib/icons'

const pathname = new URL(Astro.request.url).pathname
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-(--color-bg)/80 border-b border-(--color-border)">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex h-16 justify-between gap-4">
    <a href="/" aria-label="Wouter Vernaillen, home" class="shrink-0">
      <svg viewBox="0 0 754 276" class="h-7 w-auto cursor-pointer" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
        <g fill="none">
          <path class="fill-black dark:fill-vernaillen-500" d="M0 0 H92 V184 H172 V0 H264 V184 H344 V0 H436 V276 H0 Z" />
          <path class="fill-vernaillen-500 dark:fill-white" d="M490 0 H582 V184 H662 V0 H754 V276 H490 Z" />
        </g>
      </svg>
    </a>

    <nav class="hidden md:flex items-center gap-1 font-mono text-sm">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-astro-prefetch
          class:list={[
            'px-2 py-1 rounded transition-colors',
            isNavLinkActive(link, pathname)
              ? 'text-(--color-text)'
              : 'text-(--color-text-muted) hover:text-(--color-text)',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-search-open
        aria-label="Search (⌘K)"
        class="inline-flex h-9 items-center gap-2 rounded-full px-2.5 font-mono text-xs text-(--color-text-muted) hover:bg-(--color-bg-muted) hover:text-(--color-text) transition-colors"
      >
        <Icon name="lucide:search" class="size-4" />
        <kbd class="hidden md:inline rounded border border-(--color-border) px-1 text-[10px] leading-4">⌘K</kbd>
      </button>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        class="inline-flex size-9 items-center justify-center rounded-full hover:bg-(--color-bg-muted) transition-colors"
      >
        <Icon name="lucide:sun" class="size-4 hidden dark:block" />
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-label="Toggle menu"
        aria-expanded="false"
        class="md:hidden inline-flex size-9 items-center justify-center rounded-full hover:bg-(--color-bg-muted) transition-colors"
      >
        <Icon name="lucide:menu" class="size-4" />
      </button>
    </div>
  </div>

  <nav data-menu-panel hidden class="md:hidden border-t border-(--color-border) px-4 py-3 flex flex-col gap-1 font-mono text-sm">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-astro-prefetch
        class:list={[
          'flex items-center gap-2 px-2 py-2 rounded transition-colors',
          isNavLinkActive(link, pathname)
            ? 'text-(--color-text)'
            : 'text-(--color-text-muted) hover:text-(--color-text)',
        ]}
      >
        <Icon name={resolveIcon(link.icon)} class="size-4" />
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script src="../scripts/menu.ts"></script>
<script src="../scripts/theme.ts"></script>
