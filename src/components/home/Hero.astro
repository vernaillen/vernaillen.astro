---
import { Image } from 'astro:assets'
import Button from '../Button.astro'
import { socialLinks } from '../../lib/site'
import { Icon } from 'astro-icon/components'
import { resolveIcon } from '../../lib/icons'
import { localImage } from '../../lib/images'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}

const { data } = Astro.props
const avatar = await localImage('/images/woutervernaillen.jpg')
---

<section class="hero-glow dot-pattern relative overflow-hidden py-20 sm:py-28 text-center">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5">
    {avatar && (
      <Image
        src={avatar}
        alt="Wouter Vernaillen"
        width={72}
        height={72}
        class="size-18 rounded-full ring-2 ring-(--color-border) ring-offset-4 ring-offset-(--color-bg) object-cover"
      />
    )}

    <div>
      <h1 class="text-3xl sm:text-5xl tracking-tight">{data.title}</h1>
      <p class="pt-4 text-xl sm:text-2xl lg:text-3xl font-mono text-(--color-text-muted)">{data.title2}</p>
    </div>

    <p class="text-(--color-text-muted)">{data.description}</p>

    <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
      {data.hero.links.map((link) => (
        <Button label={link.label} to={link.to} icon={link.icon} variant={link.variant} size={link.size ?? 'lg'} />
      ))}
    </div>

    <div class="flex items-center gap-3 pt-2">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class="inline-flex size-9 items-center justify-center rounded-full text-(--color-text-muted) hover:bg-(--color-bg-muted) hover:text-(--color-text) transition-colors"
        >
          <Icon name={resolveIcon(link.icon)} class="size-4" />
        </a>
      ))}
    </div>
  </div>
</section>
