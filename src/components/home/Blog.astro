---
import BlogPostCard from '../BlogPostCard.astro'
import SectionHeading from '../SectionHeading.astro'
import type { CollectionEntry } from 'astro:content'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
  posts: CollectionEntry<'blog'>[]
}
const { data, posts } = Astro.props
---

<div class="flex flex-col gap-6">
  <div class="reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <SectionHeading title={data.blog.title} description={data.blog.description} />
    <a href="/blog" data-astro-prefetch class="shrink-0 font-mono text-sm text-vernaillen-500 hover:underline underline-offset-4">All posts &rarr;</a>
  </div>
  <div class="flex flex-col gap-3">
    {posts.map((post, index) => (
      <BlogPostCard post={post} orientation="horizontal" eager={index === 0} />
    ))}
  </div>
</div>
