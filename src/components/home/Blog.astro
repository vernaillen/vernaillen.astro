---
import PostRow from '../PostRow.astro'
import SectionLabel from '../SectionLabel.astro'
import type { CollectionEntry } from 'astro:content'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
  posts: CollectionEntry<'blog'>[]
}
const { data, posts } = Astro.props
---

<section class="grid lg:grid-cols-12 border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-10">
    <SectionLabel label="writing" />
  </div>
  <div class="lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-10 flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <h2 class="section-title">{data.blog.title}</h2>
      {data.blog.description && <p class="text-base text-(--color-text-muted) max-w-2xl">{data.blog.description}</p>}
    </div>
    <div class="flex flex-col -mx-6 lg:-mx-8">
      {posts.map((post, index) => (
        <PostRow post={post} eager={index === 0} first={index === 0} />
      ))}
      <a
        href="/blog"
        class="border-t border-(--color-border) px-5 sm:px-8 py-5 font-mono uppercase text-xs tracking-[0.08em] text-(--color-accent-text) hover:underline underline-offset-4"
      >
        All posts &rarr;
      </a>
    </div>
  </div>
</section>
