---
import SectionLabel from '../SectionLabel.astro'
import { renderInlineMarkdown } from '../../lib/inline-markdown'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<section class="grid lg:grid-cols-12 border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-8">
    <SectionLabel index="02" label="about" />
  </div>
  <div class="lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-8 flex flex-col gap-6">
    <h2 class="section-title">{data.about.title}</h2>
    <div class="lg:columns-2 gap-10 text-base leading-relaxed text-(--color-text-muted)" set:html={renderInlineMarkdown(data.about.description)} />
  </div>
</section>
