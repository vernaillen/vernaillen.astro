---
import SectionHeading from '../SectionHeading.astro'
import Button from '../Button.astro'
import { renderInlineMarkdown } from '../../lib/inline-markdown'
import { site } from '../../lib/site'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-4 rounded-lg border border-(--color-border) bg-(--color-bg-elevated)/40 p-6">
    <SectionHeading index="01" eyebrow="about" title={data.about.title} />
    <p class="text-sm text-(--color-text-muted) leading-relaxed" set:html={renderInlineMarkdown(data.about.description)} />
  </div>
  <div class="flex flex-wrap items-center gap-3 rounded-lg border border-(--color-border) bg-(--color-bg-elevated)/40 p-6">
    <Button label="Book a call" to={site.meetingLink} icon="lucide:calendar" variant="solid" target="_blank" />
    <Button label={site.email} to={`mailto:${site.email}`} icon="lucide:mail" variant="outline" />
  </div>
</div>
