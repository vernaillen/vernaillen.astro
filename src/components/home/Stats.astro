---
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28">
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-px rounded-lg border border-(--color-border) overflow-hidden">
    {data.stats.map((stat) => (
      <div class="reveal flex flex-col items-center justify-center gap-1 py-6 px-4 bg-(--color-bg-elevated)/40">
        <span class="text-3xl sm:text-4xl font-semibold tracking-tight text-vernaillen-500">{stat.value}</span>
        <span class="font-mono text-xs text-(--color-text-muted)">{stat.label}</span>
      </div>
    ))}
  </div>
</section>
