---
import { Icon } from 'astro-icon/components'
import Eyebrow from '../Eyebrow.astro'
import { resolveIcon } from '../../lib/icons'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<div class="flex flex-col gap-4 rounded-lg border border-(--color-border) bg-(--color-bg-elevated)/40 p-6">
  <div class="flex flex-col gap-2">
    <Eyebrow index="02" label="experience" />
    <h2 class="section-title text-2xl sm:text-2xl lg:text-3xl tracking-tight">{data.experience.title}</h2>
  </div>
  <div class="flex flex-col gap-3">
    {data.experience.items.map((item) => (
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-(--color-text-muted)">
        <p class="shrink-0 font-mono text-xs">{item.date}</p>
        <div class="hidden sm:block flex-1 border-t border-(--color-border)" />
        <a href={item.company.url} target="_blank" rel="noopener noreferrer" class="flex flex-wrap items-baseline gap-x-1 text-sm hover:text-(--color-text) transition-colors">
          <span>{item.position}</span>
          <span class="text-(--color-text) font-medium inline-flex items-center gap-1">
            {item.company.name}
            <Icon name={resolveIcon(item.company.logo)} style={{ color: item.company.color }} class="size-3.5 shrink-0" />
          </span>
        </a>
      </div>
    ))}
  </div>
</div>
