---
import SectionLabel from '../SectionLabel.astro'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<section class="grid lg:grid-cols-12 border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-10">
    <SectionLabel label="selected work" />
  </div>
  <div class="min-w-0 lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border)">
    {data.caseStudies.map((item, index) => (
      <article class:list={['flex flex-col gap-3 p-6 lg:p-10', index > 0 && 'border-t border-(--color-border)']}>
        <p class="label text-(--color-text-muted)">{item.client}</p>
        <h2 class="text-xl font-semibold tracking-tight">{item.title}</h2>
        <p class="text-sm text-(--color-text-dimmed)">{item.stack.join(' · ')}</p>
        <p class="mt-2 leading-relaxed text-(--color-text-muted)">{item.contribution}</p>
        <p class="text-sm leading-relaxed text-(--color-text-dimmed)">{item.evidence}</p>
      </article>
    ))}
  </div>
</section>
