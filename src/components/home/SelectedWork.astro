---
import SectionLabel from '../SectionLabel.astro'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<section class="grid lg:grid-cols-12 border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-8">
    <SectionLabel index="02" label="selected work" />
  </div>
  <div class="min-w-0 lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border)">
    {data.caseStudies.map((item, index) => (
      <article class:list={['grid md:grid-cols-12', index > 0 && 'border-t border-(--color-border)']}>
        <div class="md:col-span-4 p-6 lg:p-8 bg-(--color-bg-muted)">
          <p class="label text-(--color-accent-text)">{item.client}</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight">{item.title}</h2>
          <p class="mt-5 font-mono text-xs leading-relaxed text-(--color-text-dimmed)">{item.stack.join(' / ')}</p>
        </div>
        <div class="min-w-0 md:col-span-8 p-6 lg:p-8 md:border-l border-(--color-border) grid sm:grid-cols-2 gap-6">
          <div>
            <p class="label text-(--color-text-dimmed)">Challenge</p>
            <p class="mt-2 leading-relaxed text-(--color-text-muted)">{item.challenge}</p>
          </div>
          <div>
            <p class="label text-(--color-text-dimmed)">Contribution</p>
            <p class="mt-2 leading-relaxed text-(--color-text-muted)">{item.contribution}</p>
          </div>
          <p class="sm:col-span-2 border-l-2 border-(--color-vernaillen-500) pl-4 text-sm leading-relaxed text-(--color-text-muted)">
            <strong class="text-(--color-text)">Evidence:</strong> {item.evidence}
          </p>
        </div>
      </article>
    ))}
  </div>
</section>
