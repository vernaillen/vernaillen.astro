---
import { Icon } from 'astro-icon/components'
import SectionLabel from '../SectionLabel.astro'
import { renderInlineMarkdown } from '../../lib/inline-markdown'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props
---

<section class="grid lg:grid-cols-12 border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-10">
    <SectionLabel label="frequently asked" />
  </div>
  <div class="min-w-0 lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-10">
    <h2 class="section-title">{data.faq.title}</h2>
    <p class="mt-2 text-(--color-text-muted)">{data.faq.description}</p>
    <div class="max-w-3xl">
      {data.faq.categories.map((category, i) => (
        <div class:list={[i === 0 ? 'mt-8' : 'mt-10']}>
          <h3 class="text-sm font-medium text-(--color-text) mb-3">{category.title}</h3>
          <div class="border-t border-(--color-border)">
            {category.questions.map((question) => (
              <details class="group border-b border-(--color-border)">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium focus-visible:outline-none">
                  {question.label}
                  <Icon name="lucide:chevron-down" class="size-4 text-(--color-text-dimmed) transition-transform group-open:rotate-180" />
                </summary>
                <div class="pb-5 pr-8 leading-relaxed text-(--color-text-muted) [&_a]:text-(--color-accent-text) [&_a]:underline [&_a]:underline-offset-4" set:html={renderInlineMarkdown(question.content)} />
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
