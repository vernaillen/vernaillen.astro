---
import { Image } from 'astro:assets'
import SectionHeading from '../SectionHeading.astro'
import { localImage } from '../../lib/images'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props

const testimonials = await Promise.all(
  data.testimonials.map(async (testimonial) => ({
    ...testimonial,
    avatar: await localImage(testimonial.author.avatar.src),
  })),
)
---

<div class="flex flex-col gap-6">
  <SectionHeading title="Testimonials" align="center" class="reveal mx-auto" />
  <div class="grid gap-4 sm:grid-cols-3">
    {testimonials.map((testimonial) => (
      <figure class="reveal flex flex-col gap-4 rounded-lg border border-(--color-border) p-5">
        <blockquote class="text-sm text-(--color-text-muted) leading-relaxed flex-1">&ldquo;{testimonial.quote}&rdquo;</blockquote>
        <figcaption class="flex items-center gap-3">
          {testimonial.avatar && (
            <Image src={testimonial.avatar} alt={testimonial.author.name} width={36} height={36} class="size-9 rounded-full object-cover" />
          )}
          <div class="text-sm">
            <p class="text-(--color-text) font-medium">{testimonial.author.name}</p>
            <p class="text-(--color-text-muted) text-xs">{testimonial.author.description}</p>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</div>
