---
import { Image } from 'astro:assets'
import SectionLabel from '../SectionLabel.astro'
import { localImage } from '../../lib/images'
import type { IndexPage } from '../../content.config'

interface Props {
  data: IndexPage
}
const { data } = Astro.props

const testimonials = await Promise.all(
  data.testimonials.map(async (testimonial) => ({
    ...testimonial,
    avatar: await localImage(testimonial.author.avatar.src),
  })),
)
---

<section class="grid lg:grid-cols-12 bg-(--color-bg-muted) border-b border-(--color-border)">
  <div class="lg:col-span-3 p-6 lg:p-8">
    <SectionLabel index="06" label="kind words" />
  </div>
  <div class="lg:col-span-9 border-t lg:border-t-0 lg:border-l border-(--color-border) p-6 lg:p-8">
    <div class="grid sm:grid-cols-3 gap-px bg-(--color-border)">
      {testimonials.map((testimonial) => (
        <figure class="flex flex-col gap-4 bg-(--color-bg) p-5">
          <span class="text-6xl leading-none font-semibold text-vernaillen-500" aria-hidden="true">&ldquo;</span>
          <blockquote class="text-base leading-relaxed text-(--color-text-muted) flex-1">{testimonial.quote}</blockquote>
          <figcaption class="flex items-center gap-3">
            {testimonial.avatar && (
              <Image src={testimonial.avatar} alt={testimonial.author.avatar.alt} width={40} height={40} class="size-10 object-cover" />
            )}
            <div class="text-sm">
              <p class="text-(--color-text) font-medium">{testimonial.author.name}</p>
              <p class="font-mono text-xs text-(--color-text-muted)">{testimonial.author.description}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
